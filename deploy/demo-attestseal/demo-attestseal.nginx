# AttestSeal x402 demo (demo.attestseal.com)
# Stage 1 (initial): HTTP only on port 80 with ACME challenge support so
# certbot can issue a Let's Encrypt cert. Once the cert exists, the
# https-block (commented out below) is enabled and HTTP redirects to it.

server {
    listen 80;
    server_name demo.attestseal.com;

    # ACME challenge for certbot --webroot
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Initial: serve the demo over HTTP. After cert issuance, this block
    # becomes the redirect-to-https location.
    location / {
        proxy_pass http://127.0.0.1:8901;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}

